<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" xmlns:synkit="https://github.com/TieuLongPhan/SynKit" level="3" version="2">
  <model id="irreversible_isomerization" name="A -&gt; B. Deficiency zero but not weakly reversible, so no positive steady state exists for any rate constants. Not persistent: A is driven to zero.">
    <listOfCompartments>
      <compartment id="cell" spatialDimensions="3" constant="true" />
    </listOfCompartments>
    <listOfSpecies>
      <species id="s_1" compartment="cell" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false" name="A">
        <annotation>
          <synkit:speciesInfo sourceNodeId="s_1" syncrnId="s_1" />
        </annotation>
      </species>
      <species id="s_2" compartment="cell" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false" name="B">
        <annotation>
          <synkit:speciesInfo sourceNodeId="s_2" syncrnId="s_2" />
        </annotation>
      </species>
    </listOfSpecies>
    <listOfReactions>
      <reaction id="r_1" reversible="false" name="r_1">
        <listOfReactants>
          <speciesReference species="s_1" stoichiometry="1" constant="true" />
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="s_2" stoichiometry="1" constant="true" />
        </listOfProducts>
        <annotation>
          <synkit:reactionInfo syncrnId="r_1" sourceNodeId="r_1" sourceKind="rule" />
        </annotation>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
