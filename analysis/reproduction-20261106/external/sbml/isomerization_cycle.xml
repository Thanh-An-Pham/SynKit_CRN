<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" xmlns:synkit="https://github.com/TieuLongPhan/SynKit" level="3" version="2">
  <model id="isomerization_cycle" name="A -&gt; B -&gt; C -&gt; A. Weakly reversible without any single reaction being reversible; separates weak reversibility from reversibility.">
    <listOfCompartments>
      <compartment id="cell" spatialDimensions="3" constant="true" />
    </listOfCompartments>
    <listOfSpecies>
      <species id="s_1" compartment="cell" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false" name="A">
        <annotation>
          <synkit:speciesInfo sourceNodeId="s_1" syncrnId="s_1" />
        </annotation>
      </species>
      <species id="s_2" compartment="cell" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false" name="B">
        <annotation>
          <synkit:speciesInfo sourceNodeId="s_2" syncrnId="s_2" />
        </annotation>
      </species>
      <species id="s_3" compartment="cell" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false" name="C">
        <annotation>
          <synkit:speciesInfo sourceNodeId="s_3" syncrnId="s_3" />
        </annotation>
      </species>
    </listOfSpecies>
    <listOfReactions>
      <reaction id="r_1" reversible="false" name="r_1">
        <listOfReactants>
          <speciesReference species="s_1" stoichiometry="1" constant="true" />
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="s_2" stoichiometry="1" constant="true" />
        </listOfProducts>
        <annotation>
          <synkit:reactionInfo syncrnId="r_1" sourceNodeId="r_1" sourceKind="rule" />
        </annotation>
      </reaction>
      <reaction id="r_2" reversible="false" name="r_2">
        <listOfReactants>
          <speciesReference species="s_2" stoichiometry="1" constant="true" />
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="s_3" stoichiometry="1" constant="true" />
        </listOfProducts>
        <annotation>
          <synkit:reactionInfo syncrnId="r_2" sourceNodeId="r_2" sourceKind="rule" />
        </annotation>
      </reaction>
      <reaction id="r_3" reversible="false" name="r_3">
        <listOfReactants>
          <speciesReference species="s_3" stoichiometry="1" constant="true" />
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="s_1" stoichiometry="1" constant="true" />
        </listOfProducts>
        <annotation>
          <synkit:reactionInfo syncrnId="r_3" sourceNodeId="r_3" sourceKind="rule" />
        </annotation>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
